# ============================================
# Student Management System - Environment Config
# ============================================

# Server Port (optional, defaults to 8000)
PORT=8000

# JWT Secret Key (REQUIRED - change this to a strong random string)
JWT_SECRET=your_super_secret_key_change_this_in_production

# JWT Token Expiration Time (e.g., 1h, 1d, 7d)
JWT_EXPIRESIN=1d

# Node Environment (development | production)
NODE_ENV=development

# ============================================
# Database Configuration
# Note: These are also configured in database.js
# ============================================
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=school
